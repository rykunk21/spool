use std::io;

use crossterm::{
    event::{self, Event, KeyCode},
    execute,
    terminal::{disable_raw_mode, enable_raw_mode, EnterAlternateScreen, LeaveAlternateScreen},
};

use ratatui::{
    backend::CrosstermBackend,
    layout::{Constraint, Direction, Layout},
    widgets::{Block, Borders, Paragraph},
    Terminal,
};

mod cell;
use cell::Cell;

struct App {
    cells: Vec<Cell>,
    selected: usize,
    next_id: usize,
    editing: bool,
}

impl App {
    fn new() -> Self {
        Self {
            cells: vec![],
            selected: 0,
            next_id: 1,
            editing: false,
        }
    }

    fn move_up(&mut self) {
        if self.selected > 0 {
            self.selected -= 1;
        }
    }

    fn move_down(&mut self) {
        if self.selected + 1 < self.cells.len() {
            self.selected += 1;
        }
    }

    fn add_cell(&mut self) {
        let idx = if self.cells.is_empty() {
            0
        } else {
            self.selected + 1
        };
        self.cells.insert(idx, Cell::new(self.next_id));
        self.next_id += 1;
        self.selected = idx;
    }

    fn delete_cell(&mut self) {
        self.cells.remove(self.selected);

        if self.selected >= self.cells.len() {
            self.selected = self.cells.len() - 1;
        }
    }

    // This function should enter the current cell, enabling writes to happen
    // Or exit the current cell, preventing writes to happen
    fn toggle_focus(&mut self) {
        // get the current viewed cell
        match self.editing {
            true => self.editing = false,
            false => self.editing = true,
        }
    }

    /// Appends a character to the cell if toggled
    fn append_char(&mut self, ch: char) {
        self.cells[self.selected].source.push(ch);
    }

    /// Removes a character from a cell if toggled
    fn backspace(&mut self) {
        self.cells[self.selected].source.pop();
    }

    // Runs a cell
    fn run_cell(&mut self) {
        self.cells[self.selected].run();
    }
}

fn ui(frame: &mut ratatui::Frame, app: &App) {
    let constraints = vec![Constraint::Length(6); app.cells.len()];

    let chunks = Layout::default()
        .direction(Direction::Vertical)
        .constraints(constraints)
        .split(frame.area());

    for (i, cell) in app.cells.iter().enumerate() {
        let title = if i == app.selected {
            format!("Cell {} [selected]", cell.id)
        } else {
            format!("Cell {}", cell.id)
        };

        let widget = Paragraph::new(cell.source.clone())
            .block(Block::default().title(title).borders(Borders::ALL));

        frame.render_widget(widget, chunks[i]);
    }
}

fn main() -> anyhow::Result<()> {
    enable_raw_mode()?;

    let mut stdout = io::stdout();
    execute!(stdout, EnterAlternateScreen)?;

    let backend = CrosstermBackend::new(stdout);
    let mut terminal = Terminal::new(backend)?;

    let mut app = App::new();

    loop {
        terminal.draw(|f| ui(f, &app))?;

        if let Event::Key(key) = event::read()? {
            if !app.editing {
                match key.code {
                    KeyCode::Char('q') => break,
                    KeyCode::Char('j') | KeyCode::Down => app.move_down(),
                    KeyCode::Char('k') | KeyCode::Up => app.move_up(),
                    KeyCode::Char('a') => app.add_cell(),
                    KeyCode::Char('d') => app.delete_cell(),
                    KeyCode::Enter => app.toggle_focus(),
                    KeyCode::Tab => app.run_cell(),
                    _ => {}
                }
            } else {
                match key.code {
                    KeyCode::Backspace => app.backspace(),
                    KeyCode::Char(c) => app.append_char(c),
                    KeyCode::Enter => app.toggle_focus(),
                    _ => {}
                }
            }
        }
    }

    disable_raw_mode()?;
    execute!(terminal.backend_mut(), LeaveAlternateScreen)?;

    Ok(())
}
